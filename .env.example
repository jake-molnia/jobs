# SQLite file. Use a persistent volume in deployment.
DATABASE_PATH=./data/apply.db
# Required only for API writes and MCP writes. Generate: openssl rand -hex 32
WRITE_TOKEN=
# MCP connects to this running app.
APPLY_API_URL=http://localhost:3000
LOG_LEVEL=info
# Exact webhook destination origins, comma separated. Restart the app after changes.
# HTTPS required in production; explicitly allowed localhost HTTP works in development.
WEBHOOK_ALLOWED_ORIGINS=
